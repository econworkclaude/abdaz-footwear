{
  "expo": {
    "name": "ABDAZ",
    "slug": "abdaz-footwear",
    "scheme": "abdaz",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080B12",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080B12"
    },
    "android": {
      "package": "com.abdaz.footwear",
      "adaptiveIcon": {
        "backgroundColor": "#080B12",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.abdaz.footwear"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}